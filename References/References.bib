@article{Schrader2001,
	author={Schrader, D.
	and Kuhr, S.
	and Alt, W.
	and M{\"u}ller, M.
	and Gomer, V.
	and Meschede, D.},
	title={An optical conveyor belt for single neutral atoms},
	journal={Applied Physics B},
	year={2001},
	month={Dec},
	day={01},
	volume={73},
	number={8},
	pages={819-824},
	abstract={Using optical dipole forces we have realized controlled transport of a single or any desired small number of neutral atoms over a distance of a centimeter with sub-micrometer precision. A standing wave dipole trap is loaded with a prescribed number of cesium atoms from a magneto-optical trap. Mutual detuning of the counter-propagating laser beams moves the interference pattern, allowing us to accelerate and stop the atoms at preselected points along the standing wave. The transportation efficiency is close to 100{\%}. This optical `single-atom conveyor belt' represents a versatile tool for future experiments requiring deterministic delivery of a prescribed number of atoms on demand.},
	issn={1432-0649},
	doi={10.1007/s003400100722},
	url={https://doi.org/10.1007/s003400100722}
}

@article{Schultheisz1994,
	author = {Carl R. Schultheisz},
	journal = {J. Opt. Soc. Am. A},
	keywords = {Apertures; Diffraction optics; Light diffraction; Surface waves; Wavefronts; Wavelets},
	number = {2},
	pages = {774--778},
	publisher = {Optica Publishing Group},
	title = {Numerical solution of the {H}uygens--{F}resnel--{K}irchhoff diffraction of spherical waves by a circular aperture},
	volume = {11},
	month = {Feb},
	year = {1994},
	url = {https://opg.optica.org/josaa/abstract.cfm?URI=josaa-11-2-774},
	doi = {10.1364/JOSAA.11.000774},
	abstract = {Using the rigorous wave-front formulation for scalar wave diffraction of Kraus \[ J. Opt. Soc. Am. A6, 1196 ( 1989); J. Opt. Soc. Am. A9, 1132 ( 1992)\], it is shown that the two-dimensional integral used to calculate the diffraction of spherical waves by a circular aperture may be reduced to a one-dimensional integral by choosing an appropriate coordinate frame. Both the two-dimensional integral and the one-dimensional integral must be evaluated numerically, but because each dimension must be sampled at approximately N locations to calculate accurately the integral (where N is the number of wavelengths across the aperture) the two-dimensional integration will require of the order of N2 evaluations of the integrand, whereas the one-dimensional integration will require of the order of only N evaluations, a substantial decrease in computing time for apertures that are large compared with optical wavelengths.},
}

