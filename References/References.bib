	journal = {Opt. Express},
	keywords = {Interferometry; Metrological instrumentation; Laser stabilization ; Display technology; Femtosecond lasers; Optical clocks; Optical systems; Phase shift; Ultrafast lasers},
	number = {10},
	pages = {9739--9746},
	publisher = {Optica Publishing Group},
	title = {Simple piezoelectric-actuated mirror with 180 {kHz} servo bandwidth},
	volume = {18},
	month = {May},
	year = {2010},
	url = {https://opg.optica.org/oe/abstract.cfm?URI=oe-18-10-9739},
	doi = {10.1364/OE.18.009739},
	abstract = {We present a high bandwidth piezoelectric-actuated mirror for length stabilization of an optical cavity. The actuator displays a transfer function with a flat amplitude response and greater than 135{\textdegree} phase margin up to 200 kHz, allowing a 180 kHz unity gain frequency to be achieved in a closed servo loop. To the best of our knowledge, this actuator has achieved the largest servo bandwidth for a piezoelectric transducer (PZT). The actuator should be very useful in a wide variety of applications requiring precision control of optical lengths, including laser frequency stabilization, optical interferometers, and optical communications.},
}

