	journal = {J. Opt. Soc. Am. A},
	keywords = {Computer holography; Phase-only filters ; Phase modulation; Laser beam shaping; Liquid-crystal devices; Diffraction efficiency; Nematic liquid crystals; Optical trapping; Phase compensation; Phase modulation; Spatial light modulators},
	number = {7},
	pages = {1642--1651},
	publisher = {Optica Publishing Group},
	title = {Generation of high-quality higher-order {L}aguerre--{G}aussian beams using liquid-crystal-on-silicon spatial light modulators},
	volume = {25},
	month = {Jul},
	year = {2008},
	url = {https://opg.optica.org/josaa/abstract.cfm?URI=josaa-25-7-1642},
	doi = {10.1364/JOSAA.25.001642},
	abstract = {We report on the high-quality holographic generation of higher-order Laguerre-Gaussian (LG) beams using a liquid-crystal-on-silicon spatial light modulator. The effects of the input beam pattern on the output LG beam quality are investigated in detail through theoretical discussions and experiments. Correlation analyses between observed beam patterns and theoretical mode profiles reveal that higher beam quality is achieved for output LG beams generated from a top-hat input beam than from a Gaussian input beam.},
}

@article{McCarron2008,
	doi = {10.1088/0957-0233/19/10/105601},
	url = {https://doi.org/10.1088/0957-0233/19/10/105601},
	year = {2008},
	month = {aug},
	publisher = {},
	volume = {19},
	number = {10},
	pages = {105601},
	author = {McCarron, D J and King, S A and Cornish, S L},
	title = {Modulation transfer spectroscopy in atomic rubidium},
	journal = {Measurement Science and Technology},
	abstract = {We report modulation transfer spectroscopy on the D2 transitions in 85Rb and 87Rb using a simple home-built electro-optic modulator (EOM). We show that both the gradient and amplitude of modulation transfer spectroscopy signals, for the 87Rb F = 2 → F′ = 3 and the 85Rb F = 3 → F′ = 4 transitions, can be significantly enhanced by expanding the beams, improving the signals for laser frequency stabilization. The signal gradient for these transitions is increased by a factor of 3 and the peak to peak amplitude was increased by a factor of 2. The modulation transfer signal for the 85Rb F = 2 → F′ transitions is also presented to highlight how this technique can generate a single, clear line for laser frequency stabilization even in cases where there are a number of closely spaced hyperfine transitions.}
}

@article{McGloin2003,
	author = {D. McGloin and G.C. Spalding and H. Melville and W. Sibbett and K. Dholakia},
	journal = {Opt. Express},
	keywords = {Laser trapping; Computer holography; Spatial light modulators; Diffractive optical elements; Evanescent waves; Optical elements; Optical tweezers; Phase modulation; Spatial light modulators},
	number = {2},
	pages = {158--166},
	publisher = {Optica Publishing Group},
	title = {Applications of spatial light modulators in atom optics},
	volume = {11},
	month = {Jan},
	year = {2003},
	url = {https://opg.optica.org/oe/abstract.cfm?URI=oe-11-2-158},
	doi = {10.1364/OE.11.000158},
	abstract = {We discuss the application of spatial light modulators (SLMs) to the field of atom optics. We show that SLMs may be used to generate a wide variety of optical potentials that are useful for the guiding and dipole trapping of atoms. This functionality is demonstrated by the production of a number of different light potentials using a single SLM device. These include Mach-Zender interferometer patterns and the generation of a bottle-beam. We also discuss the current limitations in SLM technology with regard to the generation of both static and dynamically deformed potentials and their use in atom optics.},
}

@article{McKeever2004,
	author = {J. McKeever  and A. Boca  and A. D. Boozer  and R. Miller  and J. R. Buck  and A. Kuzmich  and H. J. Kimble },
	title = {Deterministic Generation of Single Photons from One Atom Trapped in a Cavity},
	journal = {Science},
	volume = {303},
	number = {5666},
	pages = {1992-1994},
	year = {2004},
	doi = {10.1126/science.1095232},
	URL = {https://www.science.org/doi/abs/10.1126/science.1095232},
	eprint = {https://www.science.org/doi/pdf/10.1126/science.1095232},
	abstract = {A single cesium atom trapped within the mode of an optical cavity is used to generate single photons on demand. The photon wave packets are emitted as a Gaussian beam with temporal profile and repetition rate controlled by external driving fields. Each generation attempt is inferred to succeed with a probability near unity, whereas the efficiency for creating an unpolarized photon in the total cavity output is 0.69 ± 0.10, as limited by passive cavity losses. An average of 1.4 × 104 photons are produced by each trapped atom. These results constitute an important step in quantum information science, for example, toward the realization of distributed quantum networking.}}

