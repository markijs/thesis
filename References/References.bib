@article{Birnbaum2005,
abstract = {The quantum optics phenomenon of photon blockade was predicted nearly a decade ago by analogy with Coulomb blockade of electron transport in small metallic and semiconductor structures. Now it has been demonstrated experimentally in a system involving a single atom trapped in an optical resonator within the setting of cavity quantum electrodynamics. Excitation of the atom–cavity system by a photon blocks transmission of a second photon, altering the statistics of a beam of light from random fluctuation to a more orderly photon stream. This is a landmark event in the field of quantum optics and laser science.},
author = {Birnbaum, K M and Boca, A and Miller, R and Boozer, A D and Northup, T E and Kimble, H J},
doi = {10.1038/nature03804},
issn = {1476-4687},
journal = {Nature},
number = {7047},
pages = {87--90},
title = {{Photon blockade in an optical cavity with one trapped atom}},
